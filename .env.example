# Optional: configure these to deliver real approval requests through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AGENTGUARD_APPROVAL_PHONE=

# Required for phone-accessible approval links when testing locally through a tunnel.
# Example: https://your-project.ngrok-free.app
AGENTGUARD_PUBLIC_URL=

# Required to expose WebMCP on a public origin while the Chrome origin trial is active.
# Register the deployed origin at https://developer.chrome.com/origintrials/.
WEBMCP_ORIGIN_TRIAL_TOKEN=
